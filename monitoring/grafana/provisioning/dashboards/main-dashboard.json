{
  "title": "Cloud 3-Tier Monitoring",
  "uid": "cloud3tier",
  "timezone": "browser",
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "EC2 CPU Usage %",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{
        "expr": "100 - (avg(rate(node_cpu_seconds_total{mode='idle'}[2m])) * 100)",
        "legendFormat": "CPU %"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 60},
              {"color": "red", "value": 80}
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "EC2 Memory Usage %",
      "type": "gauge",
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "targets": [{
        "expr": "(1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) * 100",
        "legendFormat": "Memory %"
      }],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 100, "unit": "percent",
          "thresholds": {
            "steps": [
              {"color": "green", "value": 0},
              {"color": "yellow", "value": 70},
              {"color": "red", "value": 85}
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Services Health Status",
      "type": "stat",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {"expr": "up{job='fastapi'}", "legendFormat": "FastAPI"},
        {"expr": "up{job='nodejs'}", "legendFormat": "Node.js"},
        {"expr": "up{job='django'}", "legendFormat": "Django"},
        {"expr": "up{job='dotnet'}", "legendFormat": ".NET"}
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {"type": "value", "options": {"0": {"text": "DOWN", "color": "red"}, "1": {"text": "UP", "color": "green"}}}
          ]
        }
      }
    },
    {
      "id": 4,
      "title": "Container CPU Usage %",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{
        "expr": "rate(container_cpu_usage_seconds_total{name=~'cloud3tier.*'}[2m]) * 100",
        "legendFormat": "{{ name }}"
      }],
      "fieldConfig": {"defaults": {"unit": "percent"}}
    },
    {
      "id": 5,
      "title": "Container Memory Usage (MB)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [{
        "expr": "container_memory_usage_bytes{name=~'cloud3tier.*'} / 1024 / 1024",
        "legendFormat": "{{ name }}"
      }],
      "fieldConfig": {"defaults": {"unit": "decmbytes"}}
    },
    {
      "id": 6,
      "title": "API Latency (ms)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [{
        "expr": "rate(container_network_transmit_bytes_total{name=~'cloud3tier.*'}[2m])",
        "legendFormat": "{{ name }}"
      }],
      "fieldConfig": {"defaults": {"unit": "ms"}}
    }
  ],
  "schemaVersion": 38,
  "version": 1
}